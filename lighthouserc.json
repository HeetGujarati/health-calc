{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/calculators/index.html",
        "http://localhost/calculators/bmi/index.html",
        "http://localhost/calculators/calorie/index.html",
        "http://localhost/guides/index.html",
        "http://localhost/guides/how-bmr-is-calculated/index.html",
        "http://localhost/charts/bmi-chart/index.html",
        "http://localhost/calories-burned/walking/index.html"
      ],
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "unused-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off",
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
