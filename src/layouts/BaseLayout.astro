---
import '../styles/global.css';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jetBrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

import Seo from '../components/Seo.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { toDir, type Locale } from '../config/locales';
import { SITE } from '../config/site';
import type { SeoMeta } from '../lib/seo/metadata';
import type { JsonLdObject } from '../lib/seo/schema';
import { buildOrganization } from '../lib/seo/schema';
import { useTranslations } from '../lib/i18n';

interface Props {
  meta: SeoMeta;
  /** Locale-independent path, used to mark the active nav item. */
  currentPath: string;
  /** Page-specific structured data. Organization is added automatically. */
  schemas?: readonly JsonLdObject[];
  /**
   * Locales this exact page exists in, for the language switcher.
   *
   * Defaults to every translated locale, which is right for core pages. Pages
   * that do not exist in every locale — the programmatic clusters outside the
   * priority thirty — pass their own list, so the switcher never offers a link
   * that 404s.
   */
  availableLocales?: readonly Locale[];
}

const { meta, currentPath, schemas = [], availableLocales = SITE.translatedLocales } = Astro.props;

const locale: Locale = meta.locale;
const dir = toDir(locale);
const t = useTranslations(locale);

/**
 * Organization is emitted sitewide, so it is added here rather than repeated by
 * every page. Everything else comes from the page.
 */
const allSchemas: readonly JsonLdObject[] = [buildOrganization(), ...schemas];

/**
 * Only the Latin subsets are preloaded. Hindi, Japanese and Arabic pages fall
 * back to the system stack for their scripts — preloading a Latin face they
 * will barely use would cost them 30 KB of bandwidth before first paint for
 * nothing. The declarations still apply to any Latin text on the page, they
 * are just fetched normally rather than preloaded.
 */
const LATIN_SCRIPT_LOCALES: readonly Locale[] = ['en', 'es', 'pt-BR', 'fr', 'de', 'it', 'id'];
const preloadLatinFonts = LATIN_SCRIPT_LOCALES.includes(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Must run before anything paints, or the page renders in the wrong theme and swaps. */}
    <ThemeScript />

    <Seo meta={meta} />

    {
      preloadLatinFonts && (
        <>
          <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />
          <link rel="preload" href={jetBrainsMonoLatin} as="font" type="font/woff2" crossorigin />
          <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
        </>
      )
    }

    {/* Generated into dist by scripts/generate-images.mjs during the build. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <JsonLd data={allSchemas} />
  </head>

  <body>
    {/* First focusable element on every page. */}
    <a href="#main" class="skip-link">{t('nav.skipToContent')}</a>

    <SiteHeader locale={locale} currentPath={currentPath} availableLocales={availableLocales} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    {/* Renders nothing while advertising and analytics are both disabled. */}
    <ConsentBanner locale={locale} />
  </body>
</html>
