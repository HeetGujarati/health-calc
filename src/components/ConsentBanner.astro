---
/**
 * Consent banner — inactive by default, and it renders nothing at all while
 * inactive.
 *
 * The site currently sets no cookies and loads no third-party scripts, so there
 * is nothing to consent to and showing a banner would be theatre. It ships now
 * because the point of a consent mechanism is that it *gates* scripts rather
 * than recording a choice after they have already loaded — that has to be built
 * before the scripts exist, not after.
 *
 * When advertising is enabled, this renders and no ad script may load until a
 * choice is made. Refusing must be exactly as easy as accepting, which is why
 * both are equally prominent buttons rather than a button and a faint link.
 *
 * For EEA and UK traffic, Google requires a certified Consent Management
 * Platform before personalised ads may be served. This is not one. DEPLOY.md
 * says so plainly, and this banner is a mechanism for the non-EEA case and a
 * placeholder for where a certified CMP would mount.
 */

const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';
const needsConsent = adsEnabled || analyticsEnabled;
---

{
  needsConsent && (
    <consent-banner
      class="fixed inset-x-0 bottom-0 z-50 border-t border-rule bg-raised p-4"
      hidden
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-heading"
    >
      <div class="mx-auto flex max-w-3xl flex-col gap-4 sm:flex-row sm:items-center">
        <div>
          <h2 id="consent-heading" class="font-display text-base font-semibold">
            Cookies on this site
          </h2>
          <p class="mt-1 max-w-[var(--measure)] text-xs text-graphite">
            We would like to set cookies for advertising. Nothing you enter into a calculator is
            ever sent anywhere. See the{' '}
            <a href="/cookies/" class="underline">
              cookie policy
            </a>
            .
          </p>
        </div>

        <div class="flex shrink-0 gap-2">
          {/*
            Refuse is listed first and styled identically. A banner where
            declining is harder than accepting does not obtain valid consent.
          */}
          <button
            type="button"
            data-consent="reject"
            class="min-h-11 rounded-md border border-edge px-4 text-base font-semibold text-ink"
          >
            Reject
          </button>
          <button
            type="button"
            data-consent="accept"
            class="min-h-11 rounded-md border border-edge bg-ink px-4 text-base font-semibold text-paper"
          >
            Accept
          </button>
        </div>
      </div>
    </consent-banner>
  )
}

{needsConsent && <script>import '../components/islands/consent';</script>}
