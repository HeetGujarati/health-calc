---
import { SITE } from '../config/site';
import type { Locale } from '../config/locales';
import { getLocalePath } from '../lib/seo/urls';
import { useTranslations, type MessageKey } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

interface Section {
  readonly heading: MessageKey;
  readonly links: readonly { readonly path: string; readonly key: MessageKey }[];
}

const SECTIONS: readonly Section[] = [
  {
    heading: 'footer.calculators',
    links: [
      { path: '/calculators', key: 'footer.allCalculators' },
      { path: '/charts', key: 'footer.referenceCharts' },
      { path: '/guides', key: 'footer.guides' },
      { path: '/calories-burned', key: 'footer.caloriesByActivity' },
      { path: '/one-rep-max', key: 'footer.oneRepMaxByLift' },
      { path: '/pace', key: 'footer.paceByDistance' },
      { path: '/search', key: 'footer.search' },
    ],
  },
  {
    heading: 'footer.about',
    links: [
      { path: '/about', key: 'footer.aboutLink' },
      { path: '/editorial-policy', key: 'footer.editorialPolicy' },
      { path: '/accessibility', key: 'footer.accessibility' },
      { path: '/contact', key: 'footer.contact' },
    ],
  },
  {
    heading: 'footer.legal',
    links: [
      { path: '/privacy', key: 'footer.privacy' },
      { path: '/terms', key: 'footer.terms' },
      { path: '/cookies', key: 'footer.cookies' },
    ],
  },
];

const year = 2026;

/**
 * The copyright line embeds a link to the editorial policy. Rather than
 * splitting the sentence in the catalog — which forces every translator into
 * English word order — the catalog holds the whole sentence and the link text
 * separately, and the sentence is split around the link text at render time.
 * A translation that moves the phrase to the front of the sentence still works.
 */
const copyright = t('footer.copyright', { year, site: SITE.name });
const linkText = t('footer.copyrightLink');
const linkIndex = copyright.indexOf(linkText);
const [beforeLink, afterLink] =
  linkIndex === -1
    ? [copyright, '']
    : [copyright.slice(0, linkIndex), copyright.slice(linkIndex + linkText.length)];
---

<footer class="mt-16 border-t border-rule bg-paper">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        SECTIONS.map((section) => (
          <nav aria-label={t(section.heading)}>
            <h2 class="mb-3 font-display text-xs font-semibold tracking-wide text-graphite uppercase">
              {t(section.heading)}
            </h2>
            <ul class="m-0 list-none space-y-2 p-0">
              {section.links.map((link) => (
                <li>
                  <a
                    href={getLocalePath(link.path, locale)}
                    class="text-base text-graphite no-underline hover:text-ink hover:underline"
                  >
                    {t(link.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {
      /*
      The sitewide standing disclaimer. Calculator pages carry a fuller one in
      the results area, above the fold, per section 4.3 rule 7 — this is the
      baseline for every other page type.
    */
    }
    <p class="mt-10 max-w-[var(--measure)] text-xs text-graphite">
      {t('footer.disclaimer', { site: SITE.name })}
    </p>

    <p class="mt-4 text-xs text-graphite">
      {beforeLink}
      {
        linkIndex !== -1 && (
          <a href={getLocalePath('/editorial-policy', locale)} class="underline hover:text-ink">
            {linkText}
          </a>
        )
      }
      {afterLink}
    </p>
  </div>
</footer>
