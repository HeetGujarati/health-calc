---
import { SITE } from '../config/site';
import { LOCALE_BY_CODE, type Locale } from '../config/locales';
import { getLocalePath } from '../lib/seo/urls';
import { useTranslations, type MessageKey } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** Current locale-independent path, so the active link can be marked. */
  currentPath: string;
  /** Locales this exact page exists in, for the language switcher. */
  availableLocales: readonly Locale[];
}

const { locale, currentPath, availableLocales } = Astro.props;
const t = useTranslations(locale);

/**
 * Site header.
 *
 * Deliberately plain: a wordmark, three links, a language switcher, a theme
 * toggle. No hero, no search bar competing with the page's own content, no
 * sticky mega-menu. The calculator has to be usable above the fold on a 360px
 * phone, and every pixel of chrome comes out of that budget.
 *
 * The language switcher is a plain `<details>` element: it opens, closes and
 * is keyboard-operable with no JavaScript at all, which keeps it working on
 * the one control most likely to be needed by someone who landed on the wrong
 * language. It links to the *same page* in each locale rather than dropping
 * the reader on a translated homepage, and only lists locales where this page
 * genuinely exists.
 */
const NAV: readonly { path: string; key: MessageKey }[] = [
  { path: '/calculators', key: 'nav.calculators' },
  { path: '/charts', key: 'nav.charts' },
  { path: '/guides', key: 'nav.guides' },
];

const isActive = (path: string): boolean =>
  currentPath === path || currentPath.startsWith(`${path}/`);

const others = availableLocales.filter((code) => code !== locale);
---

<header class="border-b border-rule bg-paper">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3"
  >
    <a
      href={getLocalePath('/', locale)}
      class="font-display text-lg font-semibold tracking-tight text-ink no-underline"
    >
      {SITE.name}
    </a>

    <nav aria-label={t('nav.main')} class="flex flex-wrap items-center gap-x-1">
      {
        NAV.map((item) => (
          <a
            href={getLocalePath(item.path, locale)}
            aria-current={isActive(item.path) ? 'page' : undefined}
            class="rounded-sm px-2 py-2 text-base text-graphite no-underline sm:px-3 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
          >
            {t(item.key)}
          </a>
        ))
      }

      {
        others.length > 0 && (
          <details class="relative">
            <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-sm px-2 text-base text-graphite marker:content-none hover:text-ink">
              <span class="sr-only">{t('nav.chooseLanguage')}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
              </svg>
              <span aria-hidden="true" class="ms-1 text-xs uppercase">
                {LOCALE_BY_CODE[locale].path}
              </span>
            </summary>

            <ul class="absolute end-0 z-10 mt-1 max-h-80 min-w-48 list-none overflow-y-auto rounded-md border border-edge bg-raised p-1 shadow-lg">
              {availableLocales.map((code) => (
                <li>
                  <a
                    href={getLocalePath(currentPath, code)}
                    hreflang={code}
                    lang={code}
                    dir={LOCALE_BY_CODE[code].dir}
                    aria-current={code === locale ? 'true' : undefined}
                    class="flex min-h-11 items-center rounded-sm px-3 text-base text-ink no-underline hover:bg-paper aria-[current]:font-semibold"
                  >
                    {LOCALE_BY_CODE[code].name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {
        /*
        Rendered server-side with a label so it is present and legible without
        JavaScript. The custom element only adds the click behaviour.
      */
      }
      <theme-toggle>
        <button
          type="button"
          aria-pressed="false"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-edge bg-raised text-ink sm:ms-1"
        >
          <span class="sr-only">{t('nav.useDarkTheme')}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path
              d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </theme-toggle>
    </nav>
  </div>
</header>

<script>
  import '../components/islands/theme-toggle';
</script>
