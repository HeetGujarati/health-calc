---
import { SITE } from '../config/site';
import type { Locale } from '../config/locales';
import { getLocalePath } from '../lib/seo/urls';

interface Props {
  locale: Locale;
  /** Current locale-independent path, so the active link can be marked. */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

/**
 * Site header.
 *
 * Deliberately plain: a wordmark, four links, a theme toggle. No hero, no
 * search bar competing with the page's own content, no sticky mega-menu. The
 * calculator has to be usable above the fold on a 360px phone, and every pixel
 * of chrome comes out of that budget.
 */
const NAV = [
  { path: '/calculators', label: 'Calculators' },
  { path: '/charts', label: 'Charts' },
  { path: '/guides', label: 'Guides' },
] as const;

const isActive = (path: string): boolean =>
  currentPath === path || currentPath.startsWith(`${path}/`);
---

<header class="border-b border-rule bg-paper">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3"
  >
    <a
      href={getLocalePath('/', locale)}
      class="font-display text-lg font-semibold tracking-tight text-ink no-underline"
    >
      {SITE.name}
    </a>

    <nav aria-label="Main" class="flex flex-wrap items-center gap-x-1">
      {
        NAV.map((item) => (
          <a
            href={getLocalePath(item.path, locale)}
            aria-current={isActive(item.path) ? 'page' : undefined}
            class="rounded-sm px-2 py-2 text-base text-graphite no-underline sm:px-3 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
          >
            {item.label}
          </a>
        ))
      }

      {
        /*
        Rendered server-side with a label so it is present and legible without
        JavaScript. The custom element only adds the click behaviour.
      */
      }
      <theme-toggle>
        <button
          type="button"
          aria-pressed="false"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-edge bg-raised text-ink sm:ml-1"
        >
          <span class="sr-only">Use dark theme</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path
              d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </theme-toggle>
    </nav>
  </div>
</header>

<script>
  import '../components/islands/theme-toggle';
</script>
