---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ACTIVITIES, activitiesByCategory } from '../../data/activities';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';

const locale = 'en' as const;
const path = '/calories-burned';

const meta = buildBaseMetadata({
  title: 'Calories burned by activity',
  description: `Energy used by ${String(ACTIVITIES.length)} activities, each with its published MET value and Compendium code, computed for your body weight and duration.`,
  path,
  locale,
  keywords: ['calories burned by activity', 'met values', 'exercise calories'],
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Calories burned', path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const groups = activitiesByCategory();
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">Calories burned by activity</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {ACTIVITIES.length} activities, each with the MET value and five-digit code from the 2024 Adult
      Compendium of Physical Activities. Every value was taken from the published source rather than from
      another calculator.
    </p>

    <div class="mt-10 space-y-10">
      {
        groups.map((group) => (
          <section aria-labelledby={`cat-${group.id}`}>
            <h2 id={`cat-${group.id}`} class="border-b border-rule pb-2 text-xl">
              {group.label}
            </h2>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-base">
                <caption class="sr-only">{group.label} activities and their MET values</caption>
                <thead>
                  <tr>
                    <th
                      scope="col"
                      class="border-b border-rule p-2 text-left text-xs text-graphite"
                    >
                      Activity
                    </th>
                    <th
                      scope="col"
                      class="border-b border-rule p-2 text-right text-xs text-graphite"
                    >
                      METs
                    </th>
                    <th
                      scope="col"
                      class="border-b border-rule p-2 text-right text-xs text-graphite"
                    >
                      Code
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {group.items.map((activity) => (
                    <tr>
                      <th scope="row" class="border-b border-rule p-2 text-left font-normal">
                        <a
                          href={getLocalePath(`/calories-burned/${activity.slug}`, locale)}
                          class="text-ink no-underline hover:text-signal hover:underline"
                        >
                          {activity.name}
                        </a>
                      </th>
                      <td class="numeral border-b border-rule p-2 text-right">{activity.met}</td>
                      <td class="numeral border-b border-rule p-2 text-right text-xs text-graphite">
                        {activity.code}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }
    </div>

    <p class="mt-12 text-xs text-graphite">
      Source: Herrmann SD, Willis EA, Ainsworth BE, et al. "2024 Adult Compendium of Physical
      Activities." Journal of Sport and Health Science 13(1), 2024, pp. 6–12. MET values are
      population averages; roughly 18% of Compendium entries are estimated rather than measured.
    </p>
  </div>
</BaseLayout>
