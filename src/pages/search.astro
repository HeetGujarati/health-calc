---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { calculatorsByCategory } from '../data/calculators';
import { buildBaseMetadata } from '../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../lib/seo/schema';
import { getLocalePath } from '../lib/seo/urls';

const locale = 'en' as const;
const path = '/search';

/**
 * The search page.
 *
 * noIndex, and deliberately so. A search results page has no stable content —
 * it renders whatever the query string asks for — and indexing it produces the
 * thin, near-duplicate pages Google's own guidance tells you to keep out of the
 * index. The robots.txt also disallows /search/?.
 *
 * The page still exists and works, which is what matters: the homepage declares
 * a SearchAction pointing here, and declaring one that does not function is a
 * structured data violation.
 *
 * Setting noIndex here also suppresses this page's hreflang alternates and its
 * sitemap entry, which the metadata builder handles automatically.
 */
const meta = buildBaseMetadata({
  title: 'Search',
  description: 'Search the calculators, guides and reference pages on this site.',
  path,
  locale,
  noIndex: true,
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Search', path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const groups = calculatorsByCategory();
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">Search</h1>

    <site-search class="mt-6 block">
      <form role="search">
        <label for="search-query" class="block text-xs font-semibold text-graphite">
          Search calculators and guides
        </label>
        <div class="mt-1 flex gap-2">
          <input
            id="search-query"
            type="search"
            name="q"
            autocomplete="off"
            class="min-h-11 w-full rounded-sm border border-edge bg-raised px-3 text-base text-ink"
          />
          <button
            type="submit"
            class="min-h-11 rounded-md border border-edge bg-ink px-4 text-base font-semibold text-paper"
          >
            Search
          </button>
        </div>
      </form>

      {/* Announced politely so a screen reader hears the result count without losing the input. */}
      <p data-search-status aria-live="polite" class="mt-4 text-xs text-graphite"></p>

      <div data-search-results></div>
    </site-search>

    {
      /*
      The full directory, server-rendered. Search needs JavaScript; this does
      not, so the page is useful either way rather than being an empty box.
    */
    }
    <section class="mt-12 border-t border-rule pt-8" aria-labelledby="browse">
      <h2 id="browse" class="text-xl">Or browse everything</h2>

      <div class="mt-6 space-y-8">
        {
          groups.map((group) => (
            <div>
              <h3 class="text-xs font-semibold tracking-wide text-graphite uppercase">
                {group.label}
              </h3>
              <ul class="mt-2 grid list-none gap-x-8 p-0 sm:grid-cols-2">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={getLocalePath(`/calculators/${item.slug}`, locale)}
                      class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
                    >
                      {item.heading}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-base">
        <a href={getLocalePath('/guides', locale)} class="text-signal underline"> All guides </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../components/islands/search';
</script>
