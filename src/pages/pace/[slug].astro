---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { DISTANCES, getDistance } from '../../data/distances';
import { buildToolMetadata } from '../../lib/seo/metadata';
import {
  buildBreadcrumbList,
  buildFaqPage,
  buildHowTo,
  buildSoftwareApplication,
  type JsonLdObject,
} from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';
import {
  DISTANCE_DEMANDS,
  DISTANCE_INTRO,
  lowerFirst,
  renderVariant,
} from '../../lib/content/templates';
import { finishTime, formatDuration, pacePerMile, splits, speedKph } from '../../lib/health/pace';
import { asSeconds } from '../../lib/health/units';
import { roundTo } from '../../lib/health/rounding';

export function getStaticPaths() {
  return DISTANCES.map((distance) => ({ params: { slug: distance.slug } }));
}

const { slug } = Astro.params;
const distance = getDistance(slug ?? '');
if (distance === null) throw new Error(`No distance for slug: ${slug ?? '(none)'}`);

const locale = 'en' as const;
const path = `/pace/${distance.slug}`;

const values = {
  distance: distance.name.toLowerCase(),
  Distance: distance.name,
  demands: distance.demands,
  demandsLower: lowerFirst(distance.demands),
};

const intro = renderVariant(DISTANCE_INTRO, distance.slug, 'intro', values);
const demands = renderVariant(DISTANCE_DEMANDS, distance.slug, 'demands', values);

const meta = buildToolMetadata({
  title: `${distance.name} pace calculator`,
  description: `${distance.name} pace chart and calculator: convert between pace, speed and finish time, with splits and an honest note on race projections.`,
  path,
  locale,
  keywords: [
    `${distance.name.toLowerCase()} pace calculator`,
    `${distance.name.toLowerCase()} pace chart`,
    `${distance.name.toLowerCase()} splits`,
  ],
  image: { url: '/og/pace.png', alt: distance.name },
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pace', path: '/pace' },
  { name: distance.name, path },
];

const midPace = distance.paceRange[Math.floor(distance.paceRange.length / 2)]!;
const midTime = finishTime(distance.metres, midPace);

const faq = [
  {
    question: `What pace do I need for a given ${distance.shortName} time?`,
    answer: `Divide the target time by the distance in kilometres. For the ${distance.name}, ${formatDuration(midPace)} per kilometre gives ${formatDuration(midTime)}. The chart below covers the range most runners race in.`,
  },
  {
    question: `How should I pace a ${distance.shortName}?`,
    answer: distance.pacing,
  },
  {
    question: `What limits performance over the ${distance.shortName}?`,
    answer: distance.demands,
  },
  {
    question: 'Are the projections to other distances reliable?',
    answer:
      'No, and the page says so. They assume the same pace holds over a different distance, which it does not — pace falls as distance rises. Riegel’s formula applies a fatigue exponent and is the right tool for actual prediction.',
  },
  {
    question: 'Why does the split table have a partial final segment?',
    answer: `Because ${distance.name} is ${String(roundTo(distance.metres / 1000, 4))} km, which is not a whole number of split intervals. The final partial segment is shown rather than dropped, since a table that ends before the finish line is wrong exactly where it matters.`,
  },
];

const schemas: JsonLdObject[] = [
  buildSoftwareApplication({
    name: `${distance.name} pace calculator`,
    description: meta.description,
    path,
    locale,
    applicationSubCategory: 'Endurance training',
  }),
  buildHowTo({
    name: `How to work out ${distance.name.toLowerCase()} pace`,
    description: meta.description,
    path,
    locale,
    totalTime: 'PT1M',
    steps: [
      {
        name: 'Enter a finish time',
        text: `Enter a target or actual ${distance.name.toLowerCase()} time as h:mm:ss or m:ss.`,
        anchor: 'step-1',
      },
      {
        name: 'Read the pace',
        text: 'Pace per kilometre and per mile, speed, and splits update as you type.',
        anchor: 'step-2',
      },
      {
        name: 'Check the pace chart',
        text: 'The chart below maps every pace in the usual range to a finish time.',
        anchor: 'step-3',
      },
    ],
  }),
];

const faqSchema = buildFaqPage(faq);
if (faqSchema !== null) schemas.push(faqSchema);
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

/** Full pace chart: pace per km against finish time, speed and pace per mile. */
const chart = distance.paceRange.map((pace) => {
  const time = finishTime(distance.metres, pace);
  return {
    pace,
    paceLabel: formatDuration(pace),
    time: formatDuration(time),
    perMile: formatDuration(pacePerMile(distance.metres, time)),
    kph: roundTo(speedKph(distance.metres, time), 1),
  };
});

/** Splits at the interval that suits this distance, using the middle pace. */
const splitRows = splits(distance.metres, asSeconds(midTime), distance.splitMetres);

const related = distance.related.map((s) => getDistance(s)).filter((entry) => entry !== null);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">{distance.name} pace calculator</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">{intro}</p>

    <calculator-widget
      data-calculator="running-pace"
      class="mt-6 block rounded-lg border border-rule bg-raised p-4 sm:p-6"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div id="step-1">
          <h2 class="sr-only">Enter a finish time</h2>
          <form novalidate>
            {/* The distance is bound to this page. */}
            <input type="hidden" name="distance" value={distance.raceId} />
            <input type="hidden" name="units" value="metric" />

            <div>
              <label for="time" class="block text-xs font-semibold text-graphite">
                Finish time
              </label>
              <input
                id="time"
                name="time"
                type="text"
                inputmode="numeric"
                value={formatDuration(midTime)}
                class="mt-1 min-h-11 w-full rounded-sm border border-edge bg-raised px-3 text-base text-ink"
              />
              <p class="mt-1 text-xs text-graphite">As h:mm:ss or m:ss, for example 25:30.</p>
            </div>

            <button
              type="submit"
              class="mt-6 min-h-11 w-full rounded-md border border-edge bg-ink px-4 text-base font-semibold text-paper sm:w-auto"
            >
              Calculate
            </button>
          </form>
        </div>

        <div id="step-2" class="lg:border-l lg:border-rule lg:pl-8">
          <h2 class="text-xs font-semibold tracking-wide text-graphite uppercase">Result</h2>
          <div data-result aria-live="polite" aria-atomic="true" class="mt-2 min-h-32"></div>
          <noscript>
            <p class="mt-2 max-w-[var(--measure)] text-base">
              Live results need JavaScript. The pace chart below is precomputed and works without
              it.
            </p>
          </noscript>
          <Disclaimer />
        </div>
      </div>
    </calculator-widget>

    <section class="mt-12" aria-labelledby="about-distance">
      <h2 id="about-distance" class="text-xl">The {distance.name.toLowerCase()}</h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">{distance.summary}</p>
      <p class="mt-4 max-w-[var(--measure)] text-base">{demands}</p>
      <p class="mt-4 max-w-[var(--measure)] text-base">{distance.pacing}</p>

      <p class="mt-4 text-xs text-graphite">
        Distance: {roundTo(distance.metres / 1000, 4)} km ({distance.metres} m).
        {
          (distance.slug === 'marathon' || distance.slug === 'half-marathon') &&
            ' Fixed by World Athletics Competition Rule 55.'
        }
      </p>
    </section>

    <section id="step-3" class="mt-12" aria-labelledby="pace-chart">
      <h2 id="pace-chart" class="text-xl">{distance.name} pace chart</h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">
        Finish time, pace per mile and speed for each pace per kilometre. Everything is computed in
        metres and seconds and converted once, so no rounding accumulates down the table.
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-base">
          <caption class="sr-only">{distance.name} pace chart</caption>
          <thead>
            <tr>
              <th scope="col" class="border-b border-rule p-2 text-left text-xs text-graphite">
                Pace / km
              </th>
              <th scope="col" class="border-b border-rule p-2 text-right text-xs text-graphite">
                Finish time
              </th>
              <th scope="col" class="border-b border-rule p-2 text-right text-xs text-graphite">
                Pace / mile
              </th>
              <th scope="col" class="border-b border-rule p-2 text-right text-xs text-graphite">
                Speed
              </th>
            </tr>
          </thead>
          <tbody>
            {
              chart.map((row) => (
                <tr>
                  <th scope="row" class="numeral border-b border-rule p-2 text-left font-normal">
                    {row.paceLabel}
                  </th>
                  <td class="numeral border-b border-rule p-2 text-right">{row.time}</td>
                  <td class="numeral border-b border-rule p-2 text-right">{row.perMile}</td>
                  <td class="numeral border-b border-rule p-2 text-right">{row.kph} km/h</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="splits">
      <h2 id="splits" class="text-xl">Splits at {formatDuration(midPace)} per kilometre</h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">
        Elapsed time at each {
          distance.splitMetres >= 1000
            ? `${String(distance.splitMetres / 1000)} km`
            : `${String(distance.splitMetres)} m`
        } point, for a {formatDuration(midTime)} finish.
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-base">
          <caption class="sr-only">Split times</caption>
          <thead>
            <tr>
              <th scope="col" class="border-b border-rule p-2 text-left text-xs text-graphite">
                Distance
              </th>
              <th scope="col" class="border-b border-rule p-2 text-right text-xs text-graphite">
                Elapsed
              </th>
            </tr>
          </thead>
          <tbody>
            {
              splitRows.map((split) => (
                <tr>
                  <th scope="row" class="numeral border-b border-rule p-2 text-left font-normal">
                    {split.cumulativeMetres >= 1000
                      ? `${String(roundTo(split.cumulativeMetres / 1000, 3))} km`
                      : `${String(split.cumulativeMetres)} m`}
                    {split.partial && <span class="ml-2 text-xs text-graphite">finish</span>}
                  </th>
                  <td class="numeral border-b border-rule p-2 text-right">
                    {formatDuration(split.cumulativeSeconds)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq">
      <h2 id="faq" class="text-xl">Questions</h2>
      <dl class="mt-4 max-w-[var(--measure)]">
        {
          faq.map((entry) => (
            <div class="border-b border-rule py-4">
              <dt class="font-display text-base font-semibold">{entry.question}</dt>
              <dd class="m-0 mt-2 text-base text-graphite">{entry.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="other-distances">
      <h2 id="other-distances" class="text-xs font-semibold tracking-wide text-graphite uppercase">
        Other distances
      </h2>
      <ul class="mt-2 grid list-none gap-x-8 p-0 sm:grid-cols-2">
        {
          related.map((entry) => (
            <li>
              <a
                href={getLocalePath(`/pace/${entry.slug}`, locale)}
                class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
              >
                {entry.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={getLocalePath('/guides/how-to-read-a-pace-chart', locale)}
            class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
          >
            How to read a pace chart
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../components/islands/calculator';
</script>
