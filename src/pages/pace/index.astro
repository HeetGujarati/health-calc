---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DISTANCES } from '../../data/distances';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';
import { roundTo } from '../../lib/health/rounding';

const locale = 'en' as const;
const path = '/pace';

const meta = buildBaseMetadata({
  title: 'Pace charts by race distance',
  description: `Pace charts and split tables for ${String(DISTANCES.length)} race distances, from 100 metres to 50 km, with conversions between pace, speed and finish time.`,
  path,
  locale,
  keywords: ['pace chart', 'race pace calculator', 'running splits'],
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pace', path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">Pace charts by race distance</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {DISTANCES.length} distances, each with a full pace chart, a split table and a note on what limits
      performance there. Marathon and half marathon lengths are the ones fixed by World Athletics.
    </p>

    <ul class="mt-10 list-none space-y-6 p-0">
      {
        DISTANCES.map((distance) => (
          <li class="border-b border-rule pb-6">
            <a
              href={getLocalePath(`/pace/${distance.slug}`, locale)}
              class="font-display text-lg font-semibold text-ink no-underline hover:text-signal hover:underline"
            >
              {distance.name}
            </a>
            <span class="numeral ml-2 text-xs text-graphite">
              {roundTo(distance.metres / 1000, 4)} km
            </span>
            <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">{distance.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
