---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CHART_DEFINITIONS } from '../../data/charts';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';

const locale = 'en' as const;
const path = '/charts';

const meta = buildBaseMetadata({
  title: 'Reference charts',
  description:
    'Printable reference tables for BMI, healthy weight, body fat, MET values, training percentages, heart rate zones, protein, pace and more.',
  path,
  locale,
  keywords: ['fitness charts', 'reference charts', 'bmi chart', 'pace chart'],
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Charts', path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">Reference charts</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {CHART_DEFINITIONS.length} reference tables, each computed from the same equations as the calculator
      it belongs to — so the two can never disagree. Every chart is real rendered data with an explanation
      of how to read it, and works with JavaScript disabled.
    </p>

    <ul class="mt-10 list-none space-y-6 p-0">
      {
        CHART_DEFINITIONS.map((chart) => (
          <li class="border-b border-rule pb-6">
            <a
              href={getLocalePath(`/charts/${chart.slug}`, locale)}
              class="font-display text-lg font-semibold text-ink no-underline hover:text-signal hover:underline"
            >
              {chart.heading}
            </a>
            <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">{chart.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
