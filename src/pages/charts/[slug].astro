---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CHART_DEFINITIONS, getChart } from '../../data/charts';
import { getCalculator } from '../../data/calculators';
import { GUIDE_TITLES } from '../../data/guides/titles';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';

export function getStaticPaths() {
  return CHART_DEFINITIONS.map((chart) => ({ params: { slug: chart.slug } }));
}

const { slug } = Astro.params;
const chart = getChart(slug ?? '');
if (chart === null) throw new Error(`No chart definition for slug: ${slug ?? '(none)'}`);

const locale = 'en' as const;
const path = `/charts/${chart.slug}`;

const meta = buildBaseMetadata({
  title: chart.metaTitle,
  description: chart.description,
  path,
  locale,
  keywords: chart.keywords,
  image: { url: '/og/charts.png', alt: chart.heading },
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Charts', path: '/charts' },
  { name: chart.heading, path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const calculator = getCalculator(chart.calculatorSlug);

const lastUpdatedLabel = new Date(chart.lastUpdated).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">{chart.heading}</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">{chart.intro}</p>

    {
      /*
      The table comes first: it is what the page is for, and someone arriving
      from a search for a chart wants the chart, not an introduction to it.
    */
    }
    <div class="mt-8 overflow-x-auto">
      <table class="w-full border-collapse text-base">
        <caption class="sr-only">{chart.table.caption}</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b border-rule p-2 text-left text-xs text-graphite">
              {chart.table.rowHeader}
            </th>
            {
              chart.table.columns.map((column) => (
                <th
                  scope="col"
                  class="numeral border-b border-rule p-2 text-right text-xs text-graphite"
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            chart.table.rows.map((row) => (
              <tr>
                <th scope="row" class="border-b border-rule p-2 text-left font-normal">
                  {row.label}
                </th>
                {row.cells.map((cell) => (
                  <td class="numeral border-b border-rule p-2 text-right">{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {/* Section 5.2 requires an explanation of how to read the chart, never a bare grid. */}
    <section class="mt-10" aria-labelledby="how-to-read">
      <h2 id="how-to-read" class="text-xl">How to read this chart</h2>
      <ul class="mt-4 max-w-[var(--measure)] list-disc space-y-2 pl-6 text-base">
        {chart.howToRead.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    {
      calculator !== null && (
        <section class="mt-10 rounded-lg border border-rule bg-raised p-4 sm:p-6">
          <h2 class="text-lg">Work it out for your own numbers</h2>
          <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">
            This chart is computed from the same equations as the calculator, so the two always
            agree.
          </p>
          <p class="mt-3">
            <a
              href={getLocalePath(`/calculators/${calculator.slug}`, locale)}
              class="inline-flex min-h-11 items-center text-base text-signal underline"
            >
              {calculator.heading}
            </a>
          </p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="chart-guides">
      <h2 id="chart-guides" class="text-xs font-semibold tracking-wide text-graphite uppercase">
        Related guides
      </h2>
      <ul class="mt-2 list-none space-y-1 p-0">
        {
          chart.relatedGuides.map((guideSlug) => (
            <li>
              <a
                href={getLocalePath(`/guides/${guideSlug}`, locale)}
                class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
              >
                {GUIDE_TITLES[guideSlug] ?? guideSlug}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-12 text-xs text-graphite">
      Last reviewed <time datetime={chart.lastUpdated}>{lastUpdatedLabel}</time>.
    </p>
  </div>
</BaseLayout>
