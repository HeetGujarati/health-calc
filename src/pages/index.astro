---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { buildBaseMetadata } from '../lib/seo/metadata';
import { buildWebSite } from '../lib/seo/schema';
import { getLocalePath } from '../lib/seo/urls';

const locale = 'en' as const;

const meta = buildBaseMetadata({
  title: 'Health and fitness calculators',
  description: SITE.defaultDescription,
  path: '/',
  locale,
  keywords: ['fitness calculators', 'health calculators'],
});

/**
 * WebSite with SearchAction is emitted on the homepage only, and only because
 * /search/ is a real working page. Declaring a SearchAction that does not
 * function is a structured-data violation.
 */
const schemas = [buildWebSite(locale)];

/**
 * The directory is the homepage. No hero, no marketing block above it — someone
 * arriving here wants to get to a calculator, and anything between them and the
 * list is in the way.
 *
 * Populated properly in phase 5; this renders the categories that exist so far.
 */
const CATEGORIES = [
  {
    heading: 'Body composition',
    items: [
      { path: '/calculators/bmi', label: 'BMI' },
      { path: '/calculators/body-fat', label: 'Body fat percentage' },
      { path: '/calculators/lean-body-mass', label: 'Lean body mass' },
      { path: '/calculators/army-body-fat', label: 'Army body composition' },
    ],
  },
  {
    heading: 'Energy and intake',
    items: [
      { path: '/calculators/bmr', label: 'BMR' },
      { path: '/calculators/tdee', label: 'TDEE' },
      { path: '/calculators/calorie', label: 'Calorie target' },
      { path: '/calculators/macro', label: 'Macros' },
      { path: '/calculators/protein', label: 'Protein intake' },
      { path: '/calculators/water-intake', label: 'Water intake' },
    ],
  },
  {
    heading: 'Training',
    items: [
      { path: '/calculators/one-rep-max', label: 'One rep max' },
      { path: '/calculators/calories-burned', label: 'Calories burned' },
      { path: '/calculators/target-heart-rate', label: 'Target heart rate' },
      { path: '/calculators/running-pace', label: 'Running pace' },
    ],
  },
  {
    heading: 'Weight reference',
    items: [
      { path: '/calculators/ideal-weight', label: 'Ideal weight' },
      { path: '/calculators/healthy-weight-range', label: 'Healthy weight range' },
    ],
  },
] as const;
---

<BaseLayout meta={meta} currentPath="/" schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-2xl sm:text-3xl">Health and fitness calculators</h1>
    <p class="mt-4 max-w-[var(--measure)] text-lg text-graphite">
      Every calculator here uses a published equation, names its source, and shows what the equation
      assumes. Metric and imperial, no sign-up.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        CATEGORIES.map((category) => (
          <section>
            <h2 class="border-b border-rule pb-2 text-lg">{category.heading}</h2>
            <ul class="mt-3 list-none space-y-1 p-0">
              {category.items.map((item) => (
                <li>
                  <a
                    href={getLocalePath(item.path, locale)}
                    class="flex min-h-11 items-center rounded-sm px-2 text-base text-ink no-underline hover:bg-raised hover:text-signal"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
