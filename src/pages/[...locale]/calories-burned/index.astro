---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { ACTIVITIES, activitiesByCategory } from '../../../data/activities';
import { buildBaseMetadata } from '../../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../../lib/seo/schema';
import { getLocalePath } from '../../../lib/seo/urls';
import { localeRoutes } from '../../../lib/i18n/routes';
import { useTranslations } from '../../../lib/i18n';
import { translateActivity } from '../../../lib/i18n/content';
import { formatNumber } from '../../../lib/i18n/format';
import { localesFor } from '../../../lib/seo/pages';
import type { Locale } from '../../../config/locales';

export function getStaticPaths() {
  return localeRoutes();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const path = '/calories-burned';

const meta = buildBaseMetadata({
  title: t('hub.activities.title'),
  description: t('hub.activities.description', { count: ACTIVITIES.length }),
  path,
  locale,
  keywords: ['calories burned by activity', 'met values', 'exercise calories'],
});

const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('hub.activities.title'), path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

/**
 * Only activities with a page in this locale are listed.
 *
 * Outside English — and any locale in FULL_PROGRAMMATIC_LOCALES — that is the
 * thirty priority pages from section 5.3, so the hub must not list all sixty
 * and point half of them at URLs that were never built.
 */
const shipsHere = (slug: string): boolean => localesFor('activities', slug).includes(locale);

const groups = activitiesByCategory()
  .map((group) => ({
    ...group,
    items: group.items
      .filter((activity) => shipsHere(activity.slug))
      .map((activity) => translateActivity(activity, locale)),
  }))
  .filter((group) => group.items.length > 0);

const shown = groups.reduce((count, group) => count + group.items.length, 0);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label={t('nav.breadcrumb')} />

    <h1 class="mt-4 text-2xl sm:text-3xl">{t('hub.activities.title')}</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {t('hub.activities.intro', { count: shown })}
    </p>

    <div class="mt-10 space-y-10">
      {
        groups.map((group) => (
          <section aria-labelledby={`cat-${group.id}`}>
            <h2 id={`cat-${group.id}`} class="border-b border-rule pb-2 text-xl">
              {group.label}
            </h2>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-base">
                <caption class="sr-only">
                  {t('hub.activities.tableCaption', { category: group.label })}
                </caption>
                <thead>
                  <tr>
                    <th
                      scope="col"
                      class="border-b border-rule p-2 text-start text-xs text-graphite"
                    >
                      {t('hub.activities.columnActivity')}
                    </th>
                    <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                      {t('hub.activities.columnMet')}
                    </th>
                    <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                      {t('hub.activities.columnCode')}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {group.items.map((activity) => (
                    <tr>
                      <th scope="row" class="border-b border-rule p-2 text-start font-normal">
                        <a
                          href={getLocalePath(`/calories-burned/${activity.slug}`, locale)}
                          class="text-ink no-underline hover:text-signal hover:underline"
                        >
                          {activity.name}
                        </a>
                      </th>
                      <td class="numeral border-b border-rule p-2 text-end">
                        {formatNumber(activity.met, locale)}
                      </td>
                      <td class="numeral border-b border-rule p-2 text-end text-xs text-graphite">
                        {activity.code}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }
    </div>

    <p class="mt-12 text-xs text-graphite">{t('hub.activities.source')}</p>

    <TranslationNotice locale={locale} path={path} />
  </div>
</BaseLayout>
