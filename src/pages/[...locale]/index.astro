---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorsByCategory } from '../../data/calculators';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildWebSite } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';
import { localeRoutes } from '../../lib/i18n/routes';
import { useTranslations, type MessageKey } from '../../lib/i18n';
import { calculatorText } from '../../lib/i18n/content';
import TranslationNotice from '../../components/TranslationNotice.astro';
import type { Locale } from '../../config/locales';

export function getStaticPaths() {
  return localeRoutes();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const meta = buildBaseMetadata({
  title: t('home.title'),
  description: t('home.description'),
  path: '/',
  locale,
  keywords: ['fitness calculators', 'health calculators'],
});

/**
 * WebSite with SearchAction is emitted on the homepage only, and only because
 * /search/ is a real working page. Declaring a SearchAction that does not
 * function is a structured-data violation.
 */
const schemas = [buildWebSite(locale)];

/**
 * The directory is the homepage. No hero, no marketing block above it — someone
 * arriving here wants to get to a calculator, and anything between them and the
 * list is in the way.
 */
const groups = calculatorsByCategory();
---

<BaseLayout meta={meta} currentPath="/" schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-2xl sm:text-3xl">{t('home.title')}</h1>
    <p class="mt-4 max-w-[var(--measure)] text-lg text-graphite">{t('home.intro')}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        groups.map((group) => (
          <section>
            <h2 class="border-b border-rule pb-2 text-lg">
              {t(`category.${group.id}` as MessageKey)}
            </h2>
            <ul class="mt-3 list-none space-y-1 p-0">
              {group.items.map((item) => (
                <li>
                  <a
                    href={getLocalePath(`/calculators/${item.slug}`, locale)}
                    class="flex min-h-11 items-center rounded-sm px-2 text-base text-ink no-underline hover:bg-raised hover:text-signal"
                  >
                    {calculatorText(item.slug, 'heading', locale, item.heading)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <TranslationNotice locale={locale} path="/" />
  </div>
</BaseLayout>
