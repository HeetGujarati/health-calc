---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { DISTANCES, getDistance } from '../../../data/distances';
import { localeItemRoutes } from '../../../lib/i18n/routes';
import { localesFor } from '../../../lib/seo/pages';
import { useTranslations } from '../../../lib/i18n';
import { translateDistance } from '../../../lib/i18n/content';
import { formatInteger, formatNumber } from '../../../lib/i18n/format';
import { variantsFor } from '../../../i18n/templates';
import type { DistanceDefinition } from '../../../data/distances';
import type { Locale } from '../../../config/locales';
import { buildToolMetadata } from '../../../lib/seo/metadata';
import {
  buildBreadcrumbList,
  buildFaqPage,
  buildHowTo,
  buildSoftwareApplication,
  type JsonLdObject,
} from '../../../lib/seo/schema';
import { getLocalePath } from '../../../lib/seo/urls';
import { lowerFirst, renderVariant } from '../../../lib/content/templates';
import {
  finishTime,
  formatDuration,
  pacePerMile,
  splits,
  speedKph,
} from '../../../lib/health/pace';
import { asSeconds } from '../../../lib/health/units';
import { roundTo } from '../../../lib/health/rounding';

export function getStaticPaths() {
  return localeItemRoutes(DISTANCES, 'distances');
}

const { locale, item } = Astro.props as { locale: Locale; item: DistanceDefinition };
const t = useTranslations(locale);
const distance = translateDistance(item, locale);
const path = `/pace/${distance.slug}`;
const lowerName = distance.name.toLowerCase();
const km = roundTo(distance.metres / 1000, 4);

const values = {
  distance: distance.name.toLowerCase(),
  Distance: distance.name,
  demands: distance.demands,
  demandsLower: lowerFirst(distance.demands),
};

const intro = renderVariant(variantsFor('distanceIntro', locale), distance.slug, 'intro', values);
const demands = renderVariant(
  variantsFor('distanceDemands', locale),
  distance.slug,
  'demands',
  values
);

const availableLocales = localesFor('distances', distance.slug);

const meta = buildToolMetadata({
  title: t('distance.h1', { distance: distance.name }),
  description: t('distance.metaDescription', { distance: distance.name }),
  path,
  locale,
  keywords: [
    t('distance.h1', { distance: lowerName }),
    t('distance.chartHeading', { distance: lowerName }),
  ],
  image: { url: '/og/pace.png', alt: distance.name },
  availableLocales,
});

const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('hub.distances.title'), path: '/pace' },
  { name: distance.name, path },
];

const midPace = distance.paceRange[Math.floor(distance.paceRange.length / 2)]!;
const midTime = finishTime(distance.metres, midPace);

const faq = [
  {
    question: t('distance.faq.q1', { short: distance.shortName }),
    answer: t('distance.faq.a1', {
      distance: distance.name,
      midPace: formatDuration(midPace),
      midTime: formatDuration(midTime),
    }),
  },
  { question: t('distance.faq.q2', { short: distance.shortName }), answer: distance.pacing },
  { question: t('distance.faq.q3', { short: distance.shortName }), answer: distance.demands },
  { question: t('distance.faq.q4'), answer: t('distance.faq.a4') },
  {
    question: t('distance.faq.q5'),
    answer: t('distance.faq.a5', {
      distance: distance.name,
      km: formatNumber(km, locale),
    }),
  },
];

const schemas: JsonLdObject[] = [
  buildSoftwareApplication({
    name: t('distance.h1', { distance: distance.name }),
    description: meta.description,
    path,
    locale,
    applicationSubCategory: 'Endurance training',
  }),
  buildHowTo({
    name: t('distance.howToName', { distanceLower: lowerName }),
    description: meta.description,
    path,
    locale,
    totalTime: 'PT1M',
    steps: [
      {
        name: t('distance.step1.name'),
        text: t('distance.step1.text', { distanceLower: lowerName }),
        anchor: 'step-1',
      },
      {
        name: t('distance.step2.name'),
        text: t('distance.step2.text'),
        anchor: 'step-2',
      },
      {
        name: t('distance.step3.name'),
        text: t('distance.step3.text'),
        anchor: 'step-3',
      },
    ],
  }),
];

const faqSchema = buildFaqPage(faq);
if (faqSchema !== null) schemas.push(faqSchema);
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

/** Full pace chart: pace per km against finish time, speed and pace per mile. */
const chart = distance.paceRange.map((pace) => {
  const time = finishTime(distance.metres, pace);
  return {
    pace,
    paceLabel: formatDuration(pace),
    time: formatDuration(time),
    perMile: formatDuration(pacePerMile(distance.metres, time)),
    kph: roundTo(speedKph(distance.metres, time), 1),
  };
});

/** Splits at the interval that suits this distance, using the middle pace. */
const splitRows = splits(distance.metres, asSeconds(midTime), distance.splitMetres);

const related = distance.related
  .map((relatedSlug) => getDistance(relatedSlug))
  .filter((entry) => entry !== null)
  .filter((entry) => localesFor('distances', entry.slug).includes(locale))
  .map((entry) => translateDistance(entry, locale));
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas} availableLocales={availableLocales}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label={t('nav.breadcrumb')} />

    <h1 class="mt-4 text-2xl sm:text-3xl">{t('distance.h1', { distance: distance.name })}</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">{intro}</p>

    <calculator-widget
      data-calculator="running-pace"
      class="mt-6 block rounded-lg border border-rule bg-raised p-4 sm:p-6"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div id="step-1">
          <h2 class="sr-only">{t('distance.enterTime')}</h2>
          <form novalidate>
            {/* The distance is bound to this page. */}
            <input type="hidden" name="distance" value={distance.raceId} />
            <input type="hidden" name="units" value="metric" />

            <div>
              <label for="time" class="block text-xs font-semibold text-graphite">
                {t('distance.finishTime')}
              </label>
              <input
                id="time"
                name="time"
                type="text"
                inputmode="numeric"
                value={formatDuration(midTime)}
                class="mt-1 min-h-11 w-full rounded-sm border border-edge bg-raised px-3 text-base text-ink"
              />
              <p class="mt-1 text-xs text-graphite" dir="ltr">h:mm:ss / m:ss</p>
            </div>

            <button
              type="submit"
              class="mt-6 min-h-11 w-full rounded-md border border-edge bg-ink px-4 text-base font-semibold text-paper sm:w-auto"
            >
              {t('calc.calculate')}
            </button>
          </form>
        </div>

        <div id="step-2" class="lg:border-s lg:border-rule lg:ps-8">
          <h2 class="text-xs font-semibold tracking-wide text-graphite uppercase">
            {t('calc.result')}
          </h2>
          <div data-result aria-live="polite" aria-atomic="true" class="mt-2 min-h-32"></div>
          <noscript>
            <p class="mt-2 max-w-[var(--measure)] text-base">{t('distance.noscript')}</p>
          </noscript>
          <Disclaimer locale={locale} />
        </div>
      </div>
    </calculator-widget>

    <section class="mt-12" aria-labelledby="about-distance">
      <h2 id="about-distance" class="text-xl">
        {t('distance.aboutHeading', { distance: distance.name })}
      </h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">{distance.summary}</p>
      <p class="mt-4 max-w-[var(--measure)] text-base">{demands}</p>
      <p class="mt-4 max-w-[var(--measure)] text-base">{distance.pacing}</p>

      <p class="mt-4 text-xs text-graphite">
        {
          t('distance.length', {
            km: formatNumber(km, locale),
            metres: formatInteger(distance.metres, locale),
          })
        }{' '}
        {
          (distance.slug === 'marathon' || distance.slug === 'half-marathon') &&
            t('distance.fixedByRules')
        }
      </p>
    </section>

    <section id="step-3" class="mt-12" aria-labelledby="pace-chart">
      <h2 id="pace-chart" class="text-xl">
        {t('distance.chartHeading', { distance: distance.name })}
      </h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">{t('distance.chartNote')}</p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-base">
          <caption class="sr-only"
            >{t('distance.chartHeading', { distance: distance.name })}</caption
          >
          <thead>
            <tr>
              <th scope="col" class="border-b border-rule p-2 text-start text-xs text-graphite">
                {t('distance.columnPaceKm')}
              </th>
              <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                {t('distance.finishTime')}
              </th>
              <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                {t('distance.columnPaceMile')}
              </th>
              <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                {t('distance.columnSpeed')}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              chart.map((row) => (
                <tr>
                  <th scope="row" class="numeral border-b border-rule p-2 text-start font-normal">
                    {row.paceLabel}
                  </th>
                  <td class="numeral border-b border-rule p-2 text-end">{row.time}</td>
                  <td class="numeral border-b border-rule p-2 text-end">{row.perMile}</td>
                  <td class="numeral border-b border-rule p-2 text-end">{row.kph} km/h</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="splits">
      <h2 id="splits" class="text-xl">{t('distance.splits')}</h2>
      <p class="mt-3 max-w-[var(--measure)] text-base">
        <span class="numeral">{formatDuration(midPace)}</span> / km ·{' '}
        <span class="numeral">{formatDuration(midTime)}</span>
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-base">
          <caption class="sr-only">{t('distance.splits')}</caption>
          <thead>
            <tr>
              <th scope="col" class="border-b border-rule p-2 text-start text-xs text-graphite">
                {t('distance.columnDistance')}
              </th>
              <th scope="col" class="border-b border-rule p-2 text-end text-xs text-graphite">
                {t('distance.columnElapsed')}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              splitRows.map((split) => (
                <tr>
                  <th scope="row" class="numeral border-b border-rule p-2 text-start font-normal">
                    {split.cumulativeMetres >= 1000
                      ? `${String(roundTo(split.cumulativeMetres / 1000, 3))} km`
                      : `${String(split.cumulativeMetres)} m`}
                    {split.partial && <span class="ms-2 text-xs text-graphite">&rarr;</span>}
                  </th>
                  <td class="numeral border-b border-rule p-2 text-end">
                    {formatDuration(split.cumulativeSeconds)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq">
      <h2 id="faq" class="text-xl">{t('calc.questions')}</h2>
      <dl class="mt-4 max-w-[var(--measure)]">
        {
          faq.map((entry) => (
            <div class="border-b border-rule py-4">
              <dt class="font-display text-base font-semibold">{entry.question}</dt>
              <dd class="m-0 mt-2 text-base text-graphite">{entry.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="other-distances">
      <h2 id="other-distances" class="text-xs font-semibold tracking-wide text-graphite uppercase">
        {t('distance.otherDistances')}
      </h2>
      <ul class="mt-2 grid list-none gap-x-8 p-0 sm:grid-cols-2">
        {
          related.map((entry) => (
            <li>
              <a
                href={getLocalePath(`/pace/${entry.slug}`, locale)}
                class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
              >
                {entry.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={getLocalePath('/guides/how-to-read-a-pace-chart', locale)}
            class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
          >
            {t('distance.paceChartGuide')}
          </a>
        </li>
      </ul>
    </section>

    <TranslationNotice locale={locale} path={path} />
  </div>
</BaseLayout>

<script>
  import '../../../components/islands/calculator';
</script>
