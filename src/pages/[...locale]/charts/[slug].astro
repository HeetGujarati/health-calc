---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CHART_DEFINITIONS } from '../../../data/charts';
import { getCalculator } from '../../../data/calculators';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { localeItemRoutes } from '../../../lib/i18n/routes';
import { useTranslations } from '../../../lib/i18n';
import { translateCalculator, translateChart } from '../../../lib/i18n/content';
import { formatDate } from '../../../lib/i18n/format';
import { guidesFor, guideSlug } from '../../../lib/i18n/guides';
import type { ChartDefinition } from '../../../data/charts';
import type { Locale } from '../../../config/locales';
import { buildBaseMetadata } from '../../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../../lib/seo/schema';
import { getLocalePath } from '../../../lib/seo/urls';

export function getStaticPaths() {
  return localeItemRoutes(CHART_DEFINITIONS, 'charts');
}

const { locale, item } = Astro.props as { locale: Locale; item: ChartDefinition };
const t = useTranslations(locale);
const chart = translateChart(item, locale);
const path = `/charts/${chart.slug}`;

const meta = buildBaseMetadata({
  title: chart.metaTitle,
  description: chart.description,
  path,
  locale,
  keywords: chart.keywords,
  image: { url: '/og/charts.png', alt: chart.heading },
});

const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('hub.charts.title'), path: '/charts' },
  { name: chart.heading, path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const source = getCalculator(chart.calculatorSlug);
const calculator = source === null ? null : translateCalculator(source, locale);

// The table is shared with that calculator, so its labels are translated
// once, there, rather than duplicated into the chart catalog.
const table = calculator?.referenceTable ?? chart.table;

const localeGuides = await guidesFor(locale);
const relatedGuides = chart.relatedGuides
  .map((slug) => localeGuides.find((entry) => guideSlug(entry) === slug))
  .filter((entry) => entry !== undefined);

const lastUpdatedLabel = formatDate(chart.lastUpdated, locale);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label={t('nav.breadcrumb')} />

    <h1 class="mt-4 text-2xl sm:text-3xl">{chart.heading}</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">{chart.intro}</p>

    {
      /*
      The table comes first: it is what the page is for, and someone arriving
      from a search for a chart wants the chart, not an introduction to it.
    */
    }
    <div class="mt-8 overflow-x-auto">
      <table class="w-full border-collapse text-base">
        <caption class="sr-only">{table.caption}</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b border-rule p-2 text-start text-xs text-graphite">
              {table.rowHeader}
            </th>
            {
              table.columns.map((column) => (
                <th
                  scope="col"
                  class="numeral border-b border-rule p-2 text-end text-xs text-graphite"
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            table.rows.map((row) => (
              <tr>
                <th scope="row" class="border-b border-rule p-2 text-start font-normal">
                  {row.label}
                </th>
                {row.cells.map((cell) => (
                  <td class="numeral border-b border-rule p-2 text-end">{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {/* Section 5.2 requires an explanation of how to read the chart, never a bare grid. */}
    <section class="mt-10" aria-labelledby="how-to-read">
      <h2 id="how-to-read" class="text-xl">{t('chart.howToRead')}</h2>
      <ul class="mt-4 max-w-[var(--measure)] list-disc space-y-2 ps-6 text-base">
        {chart.howToRead.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    {
      calculator !== null && (
        <section class="mt-10 rounded-lg border border-rule bg-raised p-4 sm:p-6">
          <h2 class="text-lg">{t('chart.workItOut')}</h2>
          <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">
            {t('chart.workItOutBody')}
          </p>
          <p class="mt-3">
            <a
              href={getLocalePath(`/calculators/${calculator.slug}`, locale)}
              class="inline-flex min-h-11 items-center text-base text-signal underline"
            >
              {calculator.heading}
            </a>
          </p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="chart-guides">
      <h2 id="chart-guides" class="text-xs font-semibold tracking-wide text-graphite uppercase">
        {t('chart.relatedGuides')}
      </h2>
      <ul class="mt-2 list-none space-y-1 p-0">
        {
          relatedGuides.map((entry) => (
            <li>
              <a
                href={getLocalePath(`/guides/${guideSlug(entry)}`, locale)}
                class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
              >
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-12 text-xs text-graphite">
      <time datetime={chart.lastUpdated}>
        {t('common.lastReviewed', { date: lastUpdatedLabel })}
      </time>
    </p>

    <TranslationNotice locale={locale} path={path} />
  </div>
</BaseLayout>
