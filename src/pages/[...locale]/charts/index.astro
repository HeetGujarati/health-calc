---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { CHART_DEFINITIONS } from '../../../data/charts';
import { buildBaseMetadata } from '../../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../../lib/seo/schema';
import { getLocalePath } from '../../../lib/seo/urls';
import { localeRoutes } from '../../../lib/i18n/routes';
import { useTranslations } from '../../../lib/i18n';
import { translateChart } from '../../../lib/i18n/content';
import type { Locale } from '../../../config/locales';

export function getStaticPaths() {
  return localeRoutes();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const path = '/charts';

const charts = CHART_DEFINITIONS.map((chart) => translateChart(chart, locale));

const meta = buildBaseMetadata({
  title: t('hub.charts.title'),
  description: t('hub.charts.description'),
  path,
  locale,
  keywords: ['fitness charts', 'reference charts', 'bmi chart', 'pace chart'],
});

const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('hub.charts.title'), path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label={t('nav.breadcrumb')} />

    <h1 class="mt-4 text-2xl sm:text-3xl">{t('hub.charts.title')}</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {t('hub.charts.intro', { count: charts.length })}
    </p>

    <ul class="mt-10 list-none space-y-6 p-0">
      {
        charts.map((chart) => (
          <li class="border-b border-rule pb-6">
            <a
              href={getLocalePath(`/charts/${chart.slug}`, locale)}
              class="font-display text-lg font-semibold text-ink no-underline hover:text-signal hover:underline"
            >
              {chart.heading}
            </a>
            <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">{chart.description}</p>
          </li>
        ))
      }
    </ul>

    <TranslationNotice locale={locale} path={path} />
  </div>
</BaseLayout>
