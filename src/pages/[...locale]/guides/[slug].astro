---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { getCalculator } from '../../../data/calculators';
import { buildArticleMetadata } from '../../../lib/seo/metadata';
import { buildArticle, buildBreadcrumbList, type JsonLdObject } from '../../../lib/seo/schema';
import { getLocalePath } from '../../../lib/seo/urls';
import { localeParam } from '../../../lib/i18n/routes';
import { localesFor } from '../../../lib/seo/pages';
import { useTranslations } from '../../../lib/i18n';
import { formatDate } from '../../../lib/i18n/format';
import { translateCalculator } from '../../../lib/i18n/content';
import { englishGuides, guideFor, guidesFor, guideSlug } from '../../../lib/i18n/guides';
import type { Locale } from '../../../config/locales';

/**
 * Guide pages.
 *
 * Article schema attributes to the organisation rather than a named person —
 * there is no author to name, and inventing one is what section 4.3 rule 8
 * forbids.
 */
export async function getStaticPaths() {
  const guides = await englishGuides();
  return guides.flatMap((guide) =>
    localesFor('guides', guide.id).map((locale) => ({
      params: { locale: localeParam(locale), slug: guide.id },
      props: { locale, slug: guide.id },
    }))
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);

const guide = await guideFor(slug, locale);
if (guide === null) throw new Error(`No guide for slug: ${slug}`);

const { Content } = await render(guide);
const path = `/guides/${slug}`;
const data = guide.data;

const meta = buildArticleMetadata({
  title: data.metaTitle ?? data.title,
  description: data.description,
  path,
  locale,
  keywords: data.keywords,
  publishedTime: data.published.toISOString(),
  modifiedTime: data.updated.toISOString(),
  image: { url: '/og/guides.png', alt: data.title },
});

const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('hub.guides.title'), path: '/guides' },
  { name: data.title, path },
];

const schemas: JsonLdObject[] = [
  buildArticle({
    headline: data.title,
    description: data.description,
    path,
    locale,
    datePublished: data.published.toISOString(),
    dateModified: data.updated.toISOString(),
  }),
];

const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const relatedCalculators = data.relatedCalculators
  .map((calculatorSlug) => getCalculator(calculatorSlug))
  .filter((entry) => entry !== null)
  .map((entry) => translateCalculator(entry, locale));

const allGuides = await guidesFor(locale);
const relatedGuides = data.relatedGuides
  .map((related) => allGuides.find((entry) => guideSlug(entry) === related))
  .filter((entry) => entry !== undefined);

const updatedIso = data.updated.toISOString().slice(0, 10);
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <article class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label={t('nav.breadcrumb')} />

    <h1 class="mt-4 text-2xl sm:text-3xl">{data.title}</h1>

    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">{data.description}</p>

    <p class="mt-4 text-xs text-graphite">
      <time datetime={updatedIso}>{formatDate(updatedIso, locale)}</time> ·{' '}
      {t('hub.guides.readingTime', { count: data.readingMinutes })}
    </p>

    {
      /*
      Prose styling is applied by descendant selectors rather than by classes in
      the markdown, so the guide files stay plain prose with no styling
      vocabulary in them — which is what makes them translatable.
    */
    }
    <div
      class="mt-8 [&_a]:text-signal [&_a]:underline [&_code]:font-mono [&_code]:text-xs [&_h2]:mt-10 [&_h2]:text-xl [&_h3]:mt-8 [&_h3]:text-lg [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:ps-6 [&_p]:mt-4 [&_p]:max-w-[var(--measure)] [&_p]:text-base [&_pre]:mt-4 [&_pre]:overflow-x-auto [&_pre]:rounded-md [&_pre]:border [&_pre]:border-rule [&_pre]:bg-raised [&_pre]:p-3 [&_pre]:text-xs [&_strong]:font-semibold [&_table]:mt-4 [&_table]:w-full [&_table]:border-collapse [&_table]:text-base [&_td]:border-b [&_td]:border-rule [&_td]:p-2 [&_th]:border-b [&_th]:border-rule [&_th]:p-2 [&_th]:text-start [&_th]:text-xs [&_th]:text-graphite [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:ps-6"
    >
      <Content />
    </div>

    <aside class="mt-12 border-t border-rule pt-8">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="text-xs font-semibold tracking-wide text-graphite uppercase">
            {t('guide.relatedCalculators')}
          </h2>
          <ul class="mt-2 list-none space-y-1 p-0">
            {
              relatedCalculators.map((entry) => (
                <li>
                  <a
                    href={getLocalePath(`/calculators/${entry.slug}`, locale)}
                    class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
                  >
                    {entry.heading}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          relatedGuides.length > 0 && (
            <div>
              <h2 class="text-xs font-semibold tracking-wide text-graphite uppercase">
                {t('guide.relatedGuides')}
              </h2>
              <ul class="mt-2 list-none space-y-1 p-0">
                {relatedGuides.map((entry) => (
                  <li>
                    <a
                      href={getLocalePath(`/guides/${guideSlug(entry)}`, locale)}
                      class="flex min-h-11 items-center text-base text-ink no-underline hover:text-signal hover:underline"
                    >
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </aside>

    <TranslationNotice locale={locale} path={path} />
  </article>
</BaseLayout>
