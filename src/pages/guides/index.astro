---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildBaseMetadata } from '../../lib/seo/metadata';
import { buildBreadcrumbList, type JsonLdObject } from '../../lib/seo/schema';
import { getLocalePath } from '../../lib/seo/urls';

const locale = 'en' as const;
const path = '/guides';

const meta = buildBaseMetadata({
  title: 'Guides',
  description:
    'Explanations of the equations behind the calculators: where they came from, what they assume, where they fail, and how much confidence the numbers deserve.',
  path,
  locale,
  keywords: ['fitness guides', 'health calculator explained'],
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path },
];

const schemas: JsonLdObject[] = [];
const breadcrumbs = buildBreadcrumbList(crumbs, locale);
if (breadcrumbs !== null) schemas.push(breadcrumbs);

const guides = await getCollection('guides');
// Sorted by title so the list is stable across builds rather than depending on
// filesystem order, which differs between platforms.
const sorted = [...guides].sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout meta={meta} currentPath={path} schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs items={crumbs} locale={locale} label="Breadcrumb" />

    <h1 class="mt-4 text-2xl sm:text-3xl">Guides</h1>
    <p class="mt-3 max-w-[var(--measure)] text-lg text-graphite">
      {sorted.length} explanations of what sits behind the calculators — where each equation came from,
      what it assumes, and how much confidence its output deserves.
    </p>

    <ul class="mt-10 list-none space-y-6 p-0">
      {
        sorted.map((guide) => (
          <li class="border-b border-rule pb-6">
            <a
              href={getLocalePath(`/guides/${guide.id}`, locale)}
              class="font-display text-lg font-semibold text-ink no-underline hover:text-signal hover:underline"
            >
              {guide.data.title}
            </a>
            <p class="mt-2 max-w-[var(--measure)] text-base text-graphite">
              {guide.data.description}
            </p>
            <p class="mt-2 text-xs text-graphite">{guide.data.readingMinutes} minute read</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
