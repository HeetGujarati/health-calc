{
  "name": "fitness-calculators",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-images.mjs",
    "preview": "astro preview",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:html": "html-validate \"dist/**/*.html\"",
    "audit:seo": "node scripts/audit-seo.mjs",
    "gate": "npm run check && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run headers && npm run audit:html && npm run audit:seo && npm run audit:budget && npm run audit:links && npm run audit:deps",
    "headers": "node scripts/generate-headers.mjs",
    "serve": "node scripts/serve.mjs",
    "audit:budget": "node scripts/audit-budget.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.2.4",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "7.0.7",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "html-validate": "11.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
